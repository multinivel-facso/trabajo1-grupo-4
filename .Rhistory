load("~/GitHub/trabajo1-grupo-4/input/data/WVS_Cross-National_Wave_7_Rdata_v6_0.RData")
## Filtrar y seleccionar -------------------------------------------------------
data <- `WVS_Cross-National_Wave_7_v6_0` %>%
select(pais=B_COUNTRY, female=Q260, nacionalismo=Q254, meanschooling, Q121,
Q124, Q126, Q128, Q129, pos_pol=Q240, seguridad=Q141, personal_income=Q288,
happiness=Q46, Life_satisfaction=Q49 ) #con variables contextuales, sin alfabetismo
data <- data %>%
set_na(., na = c(-1, -2, -3, -4, -5, -999, -9999)) #Recodificamos variables a NA
colSums(is.na(data))
data <- na.omit(data)
data <- data %>%
mutate(across(c(female), ~ case_when(
.x == 1 ~ 0,
.x == 2 ~ 1,
TRUE ~ .x
)))
dataescala <- data %>% select(Q121, Q124, Q126, Q128, Q129) #Escala migración
data <- data %>%
mutate(nacionalismo = case_when(
nacionalismo == 1 ~ 4,
nacionalismo == 2 ~ 3,
nacionalismo == 3 ~ 2,
nacionalismo == 4 ~ 1,
nacionalismo == 5 ~ NA_real_,  # Borra la respuesta 5
TRUE ~ NA_real_        # Por si hay otros valores inesperados
))
data <- na.omit(data)
table(data$Q124)
table(data$Q126)
table(data$Q128)
table(data$Q129)
data <- data %>%
mutate(across(c(Q124, Q126, Q128, Q129), ~ case_when(
.x == 0 ~ 2,
.x == 2 ~ 0,
TRUE ~ .x  # para mantener los demás valores sin cambios
)))
table(data$Q129)
table(data$Q128)
data <- data %>%
mutate(across(c(Q121), ~ case_when(
.x %in% c(1,2) ~ 0,
.x == 3 ~ 1,
.x %in% c(4, 5) ~ 2,
TRUE ~ .x
)))
dataescala <- data %>% select(Q121, Q124, Q126, Q128, Q129) #Escala migración
psych::alpha(dataescala) #Alfa de Cronbach = 0.77
rm(list = ls()) # para limpiar el entorno de trabajo
pacman::p_load(lme4,haven,foreign, stargazer, texreg, lattice, sjPlot, dplyr, ggplot2, ggeffects, parameters, stargazer, influence.ME) # paquetes a cargar # manipulacion de datos
options(scipen = 999) # para desactivar notacion cientifica
rm(list = ls()) # para limpiar el entorno de trabajo
load(file="output/data.RData")
data <- data %>%
mutate(happines_promedio_pais_gm = mean(happines_promedio_pais),
# Media general (nivel 2)
happiness_gmc = happines_promedio_pais - happines_promedio_pais_gm)
data <- data %>%
mutate(meanschooling_gm = mean(meanschooling),
# Media general (nivel 2)
meanschooling_gmc = meanschooling - meanschooling_gm)
data <- data %>%
mutate(seguridad_gm = mean(seguridad),
# Media general (nivel 2)
seguridad_gmc = seguridad - seguridad_gm)
#centrado pos_pol---------------------------------------------------
data <- data %>%
group_by(pais) %>%
mutate(pos_pol_cmc = pos_pol - mean(pos_pol, na.rm = TRUE)) %>%
ungroup()
data <- data %>%
group_by(pais) %>%
mutate(personal_income_cmc = personal_income - mean(personal_income, na.rm = TRUE)) %>%
ungroup()
data <- data %>%
group_by(pais) %>%
mutate(nacionalismo_cmc = nacionalismo - mean(nacionalismo, na.rm = TRUE)) %>%
ungroup()
save(data, file="~/GitHub/trabajo1-grupo-4/output/data.rdata")
nivel1 <- data %>%
select(op_mig, female, nacionalismo, pos_pol, personal_income)
# Variables de nivel 2 (contextual)
nivel2 <- data %>%
select(pais, happines_promedio_pais, seguridad_prom, meanschooling) %>%
distinct()  # evitar duplicados por comuna
tbl_1 <- stargazer(as.data.frame(nivel1),
type = "html",
title = "Estadísticos descriptivos de Nivel 1 (individual)",
digits = 2, summary.stat = c("n","min", "p25", "median", "mean", "p75", "max", "sd"))
tbl_2 <- stargazer(as.data.frame(nivel2),
type = "html",
title = "Estadísticos descriptivos - Nivel 2 (país)",
digits = 2, summary.stat = c("n", "min", "p25", "median", "mean", "p75", "max","sd"))
#| label: tbl-1
#| tbl-cap: "Descriptivos nivel 1"
#| tbl-cap-location: top
#| warning: false
cat(tbl_1, sep = "\n")
#| label: tbl-2
#| tbl-cap: "Descriptivos nivel 2"
#| tbl-cap-location: top
#| warning: false
cat(tbl_2, sep = "\n")
results_0 = lmer(perc_mig ~ 1 + (1 | pais), data = data)
Null_model <- summary(results_0)
ICC <- reghelper::ICC(results_0)
results_1 = lmer(perc_mig ~ 1 + female + pos_pol_cmc + nacionalismo_cmc + personal_income_cmc + (1 | pais), data = data)
modelo_1 <- screenreg(results_1, naive=TRUE) #Modelo 1, variables individuales
ICC_1 <- reghelper::ICC(results_1)
results_2 = lmer(op_mig ~ 1 + happiness_gmc + seguridad_gmc + meanschooling_gmc + (1 | pais), data = data)
results_2 = lmer(op_mig ~ 1 + happiness_gmc + seguridad_gmc + meanschooling_gmc + (1 | pais), data = data)
modelo_2 <- screenreg(results_2)#Modelo 2, variables contextuales
ICC_2 <- reghelper::ICC(results_2)
results_3 = lmer(op_mig ~ 1 + happiness_gmc + meanschooling_gmc + seguridad_gmc + female + pos_pol_cmc + nacionalismo_cmc + personal_income_cmc + (1 | pais), data = data)
results_3 = lmer(op_mig ~ 1 + happiness_gmc + meanschooling_gmc + seguridad_gmc + female + pos_pol_cmc + nacionalismo_cmc + personal_income_cmc + (1 | pais), data = data)
modelo_3 <- screenreg(results_3) #Modelo 3 multinivel
modelo_3 <- screenreg(results_3) #Modelo 3 multinivel
ICC_3 <- reghelper::ICC(results_3)
results_4= lmer (op_mig ~ 1 + meanschooling_gmc + happiness_gmc + seguridad_gmc + female + pos_pol_cmc + nacionalismo_cmc + personal_income_cmc + (1 + nacionalismo_cmc | pais), data = data)
results_4= lmer (op_mig ~ 1 + meanschooling_gmc + happiness_gmc + seguridad_gmc + female + pos_pol_cmc + nacionalismo_cmc + personal_income_cmc + (1 + nacionalismo_cmc | pais), data = data)
modelo_4 <- screenreg(results_4)#Modelo 3, pendiente aleatoria
ICC_4 <- reghelper::ICC(results_4)
results_5 = lmer(op_mig ~ 1 + meanschooling_gmc + happiness_gmc + seguridad_gmc + female + pos_pol_cmc + nacionalismo_cmc + personal_income_cmc + happiness_gmc*nacionalismo_cmc + (1 | pais), data = data)
results_5 = lmer(op_mig ~ 1 + meanschooling_gmc + happiness_gmc + seguridad_gmc + female + pos_pol_cmc + nacionalismo_cmc + personal_income_cmc + happiness_gmc*nacionalismo_cmc + (1 | pais), data = data)
modelo_5 <- screenreg(results_5)#Modelo 5, interacción entre niveles
modelo_5 <- screenreg(results_5)#Modelo 5, interacción entre niveles
ICC_5 <- reghelper::ICC(results_5)
tab_modelos <- tab_model(results_0, results_1, results_2, results_3, results_4, results_5,
show.ci = FALSE,
show.se = TRUE,
dv.labels = c("Nulo","Nivel 1", "Nivel 2", "Nivel 1 y 2", "Pendiente aleatoria nacionalismo", "Interacción entre niveles"))
