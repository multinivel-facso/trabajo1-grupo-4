data=filter(data,!pais %in% c(124, 608, 554,360, 858, 792))
results_0 = lmer(perc_mig ~ 1 + (1 | pais), data = data)
Null_model <- summary(results_0)
ICC <- reghelper::ICC(results_0)
results_1 = lmer(perc_mig ~ 1 + female + pos_pol + nacionalismo + personal_income + (1 | pais), data = data)
modelo_1 <- screenreg(results_1, naive=TRUE) #Modelo 1, variables individuales
ICC_1 <- reghelper::ICC(results_1)
results_2 = lmer(perc_mig ~ 1 + meanschooling + democ + (1 | pais), data = data)
ICC_2 <- reghelper::ICC(results_2)
results_3 = lmer(perc_mig ~ 1 + meanschooling + democ + female + pos_pol + nacionalismo + personal_income + (1 | pais), data = data)
results_3 = lmer(perc_mig ~ 1 + meanschooling + democ + female + pos_pol + nacionalismo + personal_income + (1 | pais), data = data)
modelo_3 <- screenreg(results_3) #Modelo 3 multinivel
ICC_3 <- reghelper::ICC(results_3)
reg_pend_aleatoria=lmer(perc_mig ~ 1 + meanschooling + democ + female + pos_pol + nacionalismo + personal_income +( 1 + nacionalismo | pais), data = data)
tab_modelos <- tab_model(results_0, results_1, results_2, results_3, reg_pend_aleatoria,
show.ci = FALSE,
show.se = TRUE,
dv.labels = c("Nulo","Individual", "Agregado", "Multinivel", "Pendiente aleatoria nacionalismo"))
#| label: tbl-modelos
#| tbl-cap: "Comparación Modelos"
#| tbl-cap-location: top
#| warning: false
tab_modelos
agg_mlm=data %>% group_by(pais) %>% summarise_all(funs(mean))
reg_agg=lm(perc_mig ~ + democ + meanschooling, data=agg_mlm)
tab_modelos <- tab_model(results_0, results_1, reg_agg, results_3, reg_pend_aleatoria,
show.ci = FALSE,
show.se = TRUE,
dv.labels = c("Nulo","Individual", "Agregado", "Multinivel", "Pendiente aleatoria nacionalismo"))
#| label: tbl-modelos
#| tbl-cap: "Comparación Modelos"
#| tbl-cap-location: top
#| warning: false
tab_modelos
