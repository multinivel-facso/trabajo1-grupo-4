## Filtrar y seleccionar -------------------------------------------------------
data <- `WVS_Cross-National_Wave_7_v6_0` %>%
select(pais=B_COUNTRY, female=Q260, nacionalismo=Q254, democ, meanschooling,
hdi, Q121, Q122, Q123, Q124, Q126, Q128, Q129, pos_pol=Q240, personal_income=Q288, unemploytotal) #con variables contextuales, sin alfabetismo
View(data)
data <- data %>%
set_na(., na = c(-1, -2, -3, -4, -5, -999, -9999)) #Recodificamos variables a NA
colSums(is.na(data))
data <- na.omit(data)
table(data$nacionalismo)
data <- data %>%
mutate(nacionalismo = case_when(
nacionalismo == 1 ~ 4,
nacionalismo == 2 ~ 3,
nacionalismo == 3 ~ 2,
nacionalismo == 4 ~ 1,
nacionalismo == 5 ~ NA_real_,  # Borra la respuesta 5
TRUE ~ NA_real_        # Por si hay otros valores inesperados
))
table(data$nacionalismo)
data <- na.omit(data)
data <- data %>%
mutate(across(c(Q121), ~ case_when(
.x %in% c(1,2) ~ 2,
.x == 3 ~ 1,
.x %in% c(4, 5) ~ 0,
TRUE ~ .x
)))
dataescala <- data %>% select(Q121, Q122, Q123, Q124, Q126, Q128, Q129) #Escala migración
psych::alpha(dataescala) #Alfa de Cronbach = 0.7
data <- data %>%
rowwise() %>%
mutate(perc_mig = sum(c(Q121, Q122, Q123, Q124, Q126, Q128, Q129))) %>%
ungroup() #Escala sumativa percepción de migración
data <- data %>%
mutate(across(c(Q122, Q123), ~ case_when(
.x == 2 ~ 0,
.x == 0 ~ 2,
TRUE ~ .x
))) #recodificado para mantener sentido
